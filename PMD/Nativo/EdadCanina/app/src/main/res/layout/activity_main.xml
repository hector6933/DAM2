    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/perro"
        android:src="@drawable/perro"
        android:adjustViewBounds="true"
        />

    <TextView
        android:id="@+id/texto_pregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="@string/qu_edad_tienes"
        android:textColor="@color/Rojado"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="24dp"

        />

    <EditText
        android:id="@+id/edit_edad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:ems="10"
        android:hint="@string/introduce_tu_edad"
        android:gravity="center"
        android:inputType="number"
        />

    <Button
        android:id="@+id/boton_calcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24sp"
        android:layout_marginVertical="14dp"
        android:text="@string/calcular"
        android:backgroundTint="@color/Rojado"
        android:textSize="20sp"
        />
    <TextView
        android:id="@+id/texto_respuesta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text=""
        android:textColor="@color/Rojado"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="24dp"

        />
</LinearLayout>
